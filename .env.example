# Optional overrides for docker-compose.yml (copy to .env). Every value has a local default.
APP_ENV=production
APP_DEBUG=false
# Leave empty: the api container generates one on first boot and shares it with worker/scheduler.
APP_KEY=
DB_DATABASE=online_shop
DB_USERNAME=shop
DB_PASSWORD=change-me
SEED_ON_BOOT=true
SEED_ADMIN_PASSWORD=password
SEED_CASHIER_PASSWORD=password
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
