APP_NAME="Azatech Online Shop"
APP_ENV=local
# Generate with: php artisan key:generate (the Docker entrypoint generates one automatically if empty)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=online_shop
DB_USERNAME=shop
DB_PASSWORD=change-me

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@azatech.local"
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated, never "*"
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

AUTH_TOKEN_TTL_MINUTES=480
IDEMPOTENCY_TTL_MINUTES=1440
SHOP_BUSINESS_TIMEZONE=Asia/Jakarta
API_DOCS_PUBLIC=true

# Used only by the seeder (local/demo). Change for any shared environment.
SEED_ADMIN_PASSWORD=password
SEED_CASHIER_PASSWORD=password
